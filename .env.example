# 复制为 .env 后按需修改；生产环境不要提交 .env

# 模型与日志
MALURL_MODEL_PATH=artifacts/model.joblib
MALURL_LOG_PATH=artifacts/judgements.jsonl

# 判定阈值：恶意概率 >= 该值判为恶意
MALURL_THRESHOLD=0.5
# 高危阈值：>= 该值判为高危
MALURL_HIGH_RISK=0.8

# 服务
MALURL_HOST=0.0.0.0
MALURL_PORT=8000
# 留空表示不校验；生产环境请设置强随机串
MALURL_API_KEY=
# 单次请求最多多少条 URL
MALURL_MAX_BATCH=500
# 单条 URL 长度上限，防 DoS
MALURL_MAX_URL_LEN=4096

# 是否在日志中保存原始 URL（关闭则只存哈希）
MALURL_LOG_URLS=true
